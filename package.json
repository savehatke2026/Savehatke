{
  "name": "savehatke",
  "version": "1.0.0",
  "private": true,
  "description": "SaveHatke — India's Smartest Price Tracker & Coupon Marketplace",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "verify": "node server/verify-server.js",
    "verify:security": "node verify-security.cjs",
    "verify:fail-closed": "node verify-fail-closed.cjs",
    "verify:ratelimit": "node verify-ratelimit.cjs",
    "verify:coupon-ocr": "node verify-coupon-ocr.cjs",
    "verify:all": "npm run verify:security && npm run verify:fail-closed && npm run verify:ratelimit && npm run verify:coupon-ocr",
    "audit:prod": "npm audit --omit=dev",
    "cron-secret": "node scripts/ensure-cron-secret.cjs",
    "create-brand": "node scripts/create-brand.js",
    "preview:modal": "node scripts/preview-payment-modal.cjs",
    "ai:prepare": "node scripts/ai/prepareData.js",
    "ai:vocab": "node scripts/ai/buildVocabulary.js",
    "ai:train": "node scripts/ai/train.js",
    "ai:eval": "node scripts/ai/evaluate.js",
    "ai:test": "node scripts/ai/test.js",
    "ai:build": "npm run ai:prepare && npm run ai:vocab && npm run ai:train && npm run ai:eval && npm run ai:test"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.48.1",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "google-auth-library": "^9.15.1",
    "googleapis": "^140.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.9.1",
    "nodemailer": "^10.0.13",
    "otpauth": "9.5.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "1.5.4",
    "twilio": "^6.1.0",
    "ua-parser-js": "^2.0.10",
    "uuid": "^11.1.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "dejavu-fonts-ttf": "^2.37.3",
    "jsqr": "^1.4.0",
    "pdfjs-dist": "^4.0.379",
    "pngjs": "^5.0.0",
    "puppeteer": "^23.11.1",
    "tesseract.js": "^5.1.1"
  }
}
