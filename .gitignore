# Dependencies
node_modules/

# Environment
.env
*.pem
*.json.key
service-account*.json

# Support mailbox — Gmail OAuth refresh token written by the OAuth callback
.gmail-token.json
server/.gmail-token.json

# Dedicated payment mailbox — its own Gmail OAuth refresh token
.payment-gmail-token.json
server/.payment-gmail-token.json

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
.claude/

# Build
dist/
build/
.dbg/
.vercel/
.zcode/

# Sensitive scratch files and local notes
*api key*
*task*.txt

# Local scratch scripts and their captured output. Push-script logs can contain
# credentials, so these must never be committed.
.tmp_*

# Agent working data. This directory holds memory notes AND
# backups/env-drive-token-*.txt — a live Google Drive OAuth token. The repo is
# public, so it must never be committed.
.workbuddy-ai/

# GUI test captures.
gui-test-screenshots/

# Local source assets awaiting upload. The Coupons.backgroundImage column stores
# a hosted URL, not a repo path, so no code references these files.
Coupon bg imgs/
