# ============================================
# SaveHatke Server Environment Variables
# ============================================
# This is the ONE .env file (lives at the project root, NOT inside
# server/). The legacy server/.env was merged into the root .env.
#
#   cp server/.env.example .env   # then fill in your real values
#
# .env is gitignored, so your secrets stay local.

# Server
PORT=3000

# JWT Secret (generate a long random string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Admin Credentials (Initial MongoDB Seed Credentials)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SaveHatke@Admin2024

# MongoDB Database URI (MongoDB Atlas or Local MongoDB)
# Example Local: mongodb://127.0.0.1:27017/savehatke
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/savehatke
MONGODB_URI=mongodb://127.0.0.1:27017/savehatke

# Google OAuth 2.0 Credentials (for Real Google Login)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ── Gmail Admin Mailbox Integration ─────────────────────────────
# Separate OAuth client used ONLY by the support Gmail mailbox
# (falls back to GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET when unset).
GMAIL_CLIENT_ID=your_gmail_oauth_client_id_here.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_gmail_oauth_client_secret_here

# OAuth redirect URI registered in your Google Cloud OAuth client.
# Local:  http://localhost:3000/api/admin/gmail/callback
# Prod:   https://yourdomain.com/api/admin/gmail/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/admin/gmail/callback

# AES-256-GCM key used to encrypt stored Gmail refresh tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GMAIL_TOKEN_ENCRYPTION_KEY=

# Optional — Gmail push notifications via Google Cloud Pub/Sub.
# Leave blank to use the lightweight historyId polling fallback.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_SUBSCRIPTION=

# Google Sheets Database
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Gemini AI (chatbot backend — key must stay server-side only)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# (Twilio WhatsApp notifications were removed from the project — the
#  service file is kept but reports as "unconfigured" if anything
#  still tries to call it.)

# Public base URL used to build links in transactional emails
APP_BASE_URL=https://savehatke.com

# ── Support Email (sends "request received" emails when users submit the support form) ──
# Dedicated support mailbox. If left empty, the main SMTP settings below are used.
SUPPORT_EMAIL=
SUPPORT_EMAIL_PASSWORD=
SUPPORT_SMTP_HOST=smtp.gmail.com
SUPPORT_SMTP_PORT=465
SUPPORT_FROM_NAME=SaveHatke Support

# ── Optional DKIM signing (improves inbox placement once you move off Gmail SMTP) ──
# When all three are set, the support-ack email is DKIM-signed for your own
# domain instead of gmail.com. Useful when you switch to a transactional
# service (SendGrid, SES, Resend, Postmark, Mailgun, etc.) that gives you
# a DKIM private key for savehatke.com. With Gmail's free SMTP these stay
# blank — the message is still signed by gmail.com and List-Unsubscribe
# headers handle the rest of the spam-score work.
# DKIM_DOMAIN=savehatke.com
# DKIM_SELECTOR=savehatke
# DKIM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Main SMTP (used for OTP + general transactional email) ──
EMAIL_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM=your_smtp_user@gmail.com
EMAIL_FROM_NAME=SaveHatke Security

# "From" name used by the "New sign-in detected" security alert email.
# Defaults to "SaveHatke Security" when blank.
# SECURITY_FROM_NAME=SaveHatke Security

# Set to "true" to suppress the "New sign-in detected" security alert
# that is sent to users after every successful user login. Useful while
# testing, or if you want to silence the alerts without removing the
# call site.
# SIGNIN_ALERT_DISABLED=false

# (The no-reply account for the new-user welcome email is configured
#  only in the live .env — it's not part of the public example.)

# Absolute URL of the logo shown at the top of transactional emails.
# It must be publicly reachable — a mail client cannot load a localhost
# image. Defaults to https://savehatke.vercel.app/logo.png.
# EMAIL_LOGO_URL=https://savehatke.vercel.app/logo.png

# Public site origin used to build email links (Explore SaveHatke, etc.).
# Defaults to https://savehatke.com.
# SITE_URL=https://savehatke.com

# ── Cloudflare Turnstile CAPTCHA ──
TURNSTILE_SITE_KEY=0x4AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
TURNSTILE_SECRET_KEY=0x4AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# The CAPTCHA must never be the reason a real user cannot receive their
# login code, so the verifier already lets a request through when the
# Turnstile infrastructure itself is the problem: a client on the local
# network with no token, siteverify unreachable, or a misconfigured key.
# A token that Cloudflare actively rejects is still refused.
# Set this to false to accept requests with no token from public clients
# too — useful when the widget's hostname list cannot cover a deployment
# (e.g. a preview domain). Email OTP stays rate-limited per email and IP.
# TURNSTILE_REQUIRED=true

# ── Razorpay Payment Gateway ──
# Test mode keys start with rzp_test_, live with rzp_live_.
# While these placeholders are present the checkout page falls back
# to a local demo flow.
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE

# ── Supabase (sessions, backup storage, etc.) ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ── Google Drive (coupon proof screenshots) ──
# Screenshots are uploaded with an OAuth *user* account, because service
# accounts have no Drive storage quota of their own.
# Get the refresh token once with:  cd server && node scripts/authorize-drive.js
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Optional — default to GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_VISIBILITY=private

