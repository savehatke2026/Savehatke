# ============================================
# SaveHatke Server Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# Server
PORT=3000

# JWT Secret (generate a long random string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Admin Credentials (Initial MongoDB Seed Credentials)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SaveHatke@Admin2024

# MongoDB Database URI (MongoDB Atlas or Local MongoDB)
# Example Local: mongodb://127.0.0.1:27017/savehatke
# Example Atlas: mongodb+scale://<username>:<password>@cluster.mongodb.net/savehatke
MONGODB_URI=mongodb://127.0.0.1:27017/savehatke

# Google OAuth 2.0 Credentials (for Real Google Login)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Google Sheets Database
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Gemini AI (chatbot backend — key must stay server-side only)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
