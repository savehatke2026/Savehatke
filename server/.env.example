# ============================================
# SaveHatke Server Environment Variables
# ============================================
# This is the ONE .env file (lives at the project root, NOT inside
# server/). The legacy server/.env was merged into the root .env.
#
#   cp server/.env.example .env   # then fill in your real values
#
# .env is gitignored, so your secrets stay local.

# Server
PORT=3000

# JWT Secret (generate a long random string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Admin Credentials (Initial MongoDB Seed Credentials)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SaveHatke@Admin2024

# MongoDB Database URI (MongoDB Atlas or Local MongoDB)
# Example Local: mongodb://127.0.0.1:27017/savehatke
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/savehatke
MONGODB_URI=mongodb://127.0.0.1:27017/savehatke

# Google OAuth 2.0 Credentials (for Real Google Login)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ── Gmail Admin Mailbox Integration ─────────────────────────────
# Separate OAuth client used ONLY by the support Gmail mailbox
# (falls back to GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET when unset).
GMAIL_CLIENT_ID=your_gmail_oauth_client_id_here.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_gmail_oauth_client_secret_here

# OAuth redirect URI registered in your Google Cloud OAuth client.
# Local:  http://localhost:3000/api/admin/gmail/callback
# Prod:   https://yourdomain.com/api/admin/gmail/callback
# It is only used when it matches the domain serving the request, so a
# localhost value here does not break the flow on the deployed domain.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/admin/gmail/callback

# AES-256-GCM key used to encrypt stored Gmail refresh tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GMAIL_TOKEN_ENCRYPTION_KEY=

# Support Mailbox refresh token — THIS IS THE WHOLE STORAGE LAYER.
# The Support Mailbox needs NO database: the server keeps only this token and
# reads/sends mail live through the Gmail API.
# Get it once with:  cd server && node scripts/authorize-gmail.js
# (or connect from Admin Panel > Support Mailbox, then click "Show token")
GMAIL_REFRESH_TOKEN=

# Optional — the Gmail address the panel expects to manage. Defaults to
# SUPPORT_EMAIL below; used only to warn when a different account is connected.
GMAIL_SUPPORT_EMAIL=

# Optional — where the OAuth callback caches the token while
# GMAIL_REFRESH_TOKEN is unset. Defaults to server/.gmail-token.json
# (gitignored), falling back to the OS temp dir on read-only filesystems.
GMAIL_TOKEN_FILE=

# Optional — Gmail push notifications via Google Cloud Pub/Sub.
# Leave blank to use the lightweight historyId polling fallback.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_SUBSCRIPTION=

# Google Sheets Database
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Gemini AI (chatbot backend — key must stay server-side only)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# (Twilio WhatsApp notifications were removed from the project — the
#  service file is kept but reports as "unconfigured" if anything
#  still tries to call it.)

# Public base URL used to build links in transactional emails
APP_BASE_URL=https://savehatke.com

# ── Support Email (sends "request received" emails when users submit the support form) ──
# Dedicated support mailbox. If left empty, the main SMTP settings below are used.
SUPPORT_EMAIL=
SUPPORT_EMAIL_PASSWORD=
SUPPORT_SMTP_HOST=smtp.gmail.com
SUPPORT_SMTP_PORT=465
SUPPORT_FROM_NAME=SaveHatke Support

# ── Optional DKIM signing (improves inbox placement once you move off Gmail SMTP) ──
# When all three are set, the support-ack email is DKIM-signed for your own
# domain instead of gmail.com. Useful when you switch to a transactional
# service (SendGrid, SES, Resend, Postmark, Mailgun, etc.) that gives you
# a DKIM private key for savehatke.com. With Gmail's free SMTP these stay
# blank — the message is still signed by gmail.com and List-Unsubscribe
# headers handle the rest of the spam-score work.
# DKIM_DOMAIN=savehatke.com
# DKIM_SELECTOR=savehatke
# DKIM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Main SMTP (used for OTP + general transactional email) ──
EMAIL_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM=your_smtp_user@gmail.com
EMAIL_FROM_NAME=SaveHatke Security

# "From" name used by the "New device detected" security alert email.
# Defaults to "SaveHatke Security" when blank.
# SECURITY_FROM_NAME=SaveHatke Security

# Set to "true" to suppress the "New device detected" security alert that is
# sent after a successful sign-in from a device the account has not been seen
# on before. Recognised devices never trigger it. Useful while testing, or to
# silence the alerts without removing the call site.
# SIGNIN_ALERT_DISABLED=false

# Secret used to derive the device fingerprints and to sign the device token
# cookie behind the "New device detected" alert (services/deviceRecognition.js).
# Falls back to JWT_SECRET when unset, which is fine — set it only if you want
# device recognition to rotate independently of login tokens. Changing it makes
# every device look new once, so every account gets one more alert.
# DEVICE_ID_SECRET=a_long_random_string

# (The no-reply account for the new-user welcome email is configured
#  only in the live .env — it's not part of the public example.)

# Comma-separated admin addresses for automated admin alerts (coupon
# submissions, payout requests, monthly report fallback). Falls back to the
# two built-in platform admins when unset.
# ADMIN_ALERT_EMAILS=admin1@example.com,admin2@example.com

# Absolute URL of the logo shown at the top of transactional emails.
# It must be publicly reachable — a mail client cannot load a localhost
# image. Defaults to https://savehatke.vercel.app/logo.png.
# EMAIL_LOGO_URL=https://savehatke.vercel.app/logo.png

# Public site origin used to build email links (Explore SaveHatke, etc.).
# Defaults to https://savehatke.com.
# SITE_URL=https://savehatke.com

# ── Cloudflare Turnstile CAPTCHA ──
TURNSTILE_SITE_KEY=0x4AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
TURNSTILE_SECRET_KEY=0x4AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# The CAPTCHA must never be the reason a real user cannot receive their
# login code, so the verifier already lets a request through when the
# Turnstile infrastructure itself is the problem: a client on the local
# network with no token, siteverify unreachable, or a misconfigured key.
# A token that Cloudflare actively rejects is still refused.
# Set this to false to accept requests with no token from public clients
# too — useful when the widget's hostname list cannot cover a deployment
# (e.g. a preview domain). Email OTP stays rate-limited per email and IP.
# TURNSTILE_REQUIRED=true

# ── Razorpay Payment Gateway ──
# Test mode keys start with rzp_test_, live with rzp_live_.
# While these placeholders are present the checkout page falls back
# to a local demo flow.
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE

# ── Custom UPI Checkout ──
# Orders and payments are recorded as rows in the Google Sheets spreadsheet
# above (tabs: Orders, Payments, PaymentNotifications — created automatically
# on startup). No database migration is required for them. The coupon is still
# unlocked in Supabase, because a single conditional UPDATE there is what makes
# "unlock exactly once" hold even when two servers race.
#
# The receiving VPA. This is the account the QR pays into, and the only payee
# a payment notification is accepted for. It is NOT a secret (it is printed
# inside the QR the buyer scans) but it must be correct: a mismatch parks every
# confirmation for manual review rather than unlocking a coupon. Keep the real
# value in the hosting environment (Vercel → Settings → Environment Variables)
# or in server/.env — not in the repository.
UPI_ID=savehatke@yourbank
# Name the payer sees in their UPI app.
UPI_PAYEE_NAME=SaveHatke
# Optional ceiling for a single collect request, in rupees. Guards against a
# bad coupon price turning into an absurd payment request.
PAYMENT_MAX_AMOUNT=100000

# Shared secret for POST /api/payment/webhook (gateway → server). The route
# refuses ALL requests while this is empty, so an unsigned "payment succeeded"
# can never settle an order. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Send it as the X-Payment-Signature header: HMAC-SHA256 hex of the raw body
# (a leading "sha256=" is also accepted).
PAYMENT_WEBHOOK_SECRET=

# Optional: which senders the payment mailbox is read for. Comma-separated
# domains/addresses. When unset, well-known UPI PSP and bank identifiers are
# used. Matching is additionally gated on the exact amount, the payee VPA and
# a transaction reference, so a wider net here cannot unlock anything on its own.
# PAYMENT_MAIL_FROM=famapp.in,yourbank.com
# How far back to read the payment mailbox when checking for a confirmation.
PAYMENT_MAIL_LOOKBACK_DAYS=2

# ── Supabase (sessions, backup storage, etc.) ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ── Google Drive (coupon proof screenshots) ──
# Screenshots are uploaded with an OAuth *user* account, because service
# accounts have no Drive storage quota of their own.
# Get the refresh token once with:  cd server && node scripts/authorize-drive.js
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Optional — default to GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_VISIBILITY=private
# Support-ticket screenshots. Optional, but keep it set: support screenshots are
# personal data and are always forced private, so they should not sit in the same
# folder as coupon proofs. When this is empty they fall back to
# GOOGLE_DRIVE_FOLDER_ID above.
GOOGLE_DRIVE_SUPPORT_FOLDER_ID=
# Coupon proof screenshots (the "Coupon Proofs" folder). Optional: the folder id
# ships as a default in server/services/googleDrive.js, so set this only to file
# proofs somewhere else, e.g. in a second environment. Whichever folder is used
# must be editable by the account that minted GOOGLE_DRIVE_REFRESH_TOKEN.
GOOGLE_DRIVE_COUPON_PROOF_FOLDER_ID=

# ── Monthly admin report ──
# Who receives the monthly revenue report (comma separated, max 2).
# Falls back to the two built-in admin accounts when unset.
# REPORT_ADMIN_EMAILS=admin1@example.com,admin2@example.com

# Shared secret for the scheduled report run and the session cleanup sweep.
# vercel.json schedules two crons that authenticate with it:
#   • GET /api/admin/reports/monthly/run — 02:00 UTC on the 1st of each month
#     (07:30 IST)
#   • GET /api/auth/session-cleanup — daily at 03:30 UTC (09:00 IST): flips
#     expired sessions, deletes ended sessions past the 90-day retention
#     window, and sweeps expired SOS recovery sessions
# Vercel sends the value automatically as "Authorization: Bearer
# <CRON_SECRET>"; any other scheduler may send it as "x-cron-key:
# <CRON_SECRET>" instead. Without it only a logged-in admin can trigger the
# runs, and cleanup falls back to the per-request lazy sweep and the local
# 10-minute interval — which still works, just less promptly on serverless.
# SESSION_CLEANUP_SECRET is a dedicated key for the cleanup endpoint only
# (query `secret` or `x-cleanup-secret` header) and takes precedence over
# CRON_SECRET when set.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# CRON_SECRET=
# SESSION_CLEANUP_SECRET=

